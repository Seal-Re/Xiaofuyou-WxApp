<view class="container" style="background-image: url({{backgroundUrl}});">
  <view class="custom-navbar">
    <!-- 顶部返回按钮 -->
    <image class="back-button" src="/images/utils/leftarrow.png" mode="aspectFit" bindtap="onBackTap"></image>
    <text class="navbar-title">播放</text>
  </view>
  <!-- 可选：添加整体遮罩层提升对比度 -->
  <view class="overlay"></view>

  <!-- ✅ 新增：下方虚化遮罩层 -->
  <view class="blur-mask"></view>

  <!-- 主内容部分 -->
  <swiper
    class="audio-swiper"
    circular
    previous-margin="100rpx"
    next-margin="100rpx"
    current="{{currentPlayingIndex || 0}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{audioList}}" wx:key="fileID" class="swiper-item">
      <image
        class="audio-cover {{item.isPlaying ? 'playing' : ''}}"
        src="{{item.image}}"
        mode="aspectFill"
      />
    </swiper-item>
  </swiper>

  <view class="song-info">
    <text class="song-title">{{audioList[currentPlayingIndex].name || '未知歌曲'}}</text>
  </view>

  <view class="progress-section">
    <text class="current-time">{{audioList[currentPlayingIndex].currentTime || '00:00'}}</text>
    <slider
      class="audio-slider"
      min="0"
      max="{{audioList[currentPlayingIndex].duration || 0}}"
      step="1"
      value="{{audioList[currentPlayingIndex].currentTimeRaw || 0}}"
      bindchanging="onSliderChanging"
      bindchange="onSliderChange"
      block-size="12"
      activeColor="#4CAF50"
      backgroundColor="#ccc"
      trackStyle="height: 4px;"
      block-color="#4CAF50"
    />
    <text class="total-time">{{audioList[currentPlayingIndex].totalTime || '00:00'}}</text>
  </view>

  <view class="controls-bottom">
    <button class="play-pause-btn" bindtap="togglePlay" data-index="{{currentPlayingIndex}}">
      <image
        class="play-pause-icon"
        src="{{audioList[currentPlayingIndex].isPlaying ? '/images/sound/pause.png' : '/images/sound/begin.png'}}"
        mode="aspectFit"
      />
    </button>
  </view>

  <view class="indicator-dots">
    <view
      wx:for="{{audioList}}"
      wx:key="fileID"
      class="dot {{index === currentPlayingIndex ? 'active-dot' : ''}}"
    ></view>
  </view>
</view>
