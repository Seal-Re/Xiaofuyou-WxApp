<view class="container">
  <view class="custom-navbar">
    <image class="back-button" src="/images/utils/leftarrow.png" mode="aspectFit" bindtap="onBackTap"></image>
    
    <text class="navbar-title">订单</text>
  </view>

  <view wx:if="{{toastVisible}}" class="custom-toast">
    <text>{{toastContent}}</text>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <image src="/images/loading/image.gif" class="loading-gif" mode="aspectFit" />
    <view class="loading-text {{loadingTextClass}}">加载中...</view>
  </view>

  <block wx:if="{{!isLoggedIn && !loading}}">
    <view class="empty-state">
      <image class="empty-image" src="/images/menu/empty_login.png" mode="aspectFit"></image>
      <text class="empty-text">您还未登录，请先登录查看订单</text>
      <button class="action-button" bindtap="goToLogin">前往登录</button>
    </view>
  </block>

  <block wx:elif="{{isLoggedIn && !hasOrders && !loading}}">
    <view class="empty-state">
      <image class="empty-image" src="https://636c-cloud1-0g3x66x78d3885d5-1327118671.tcb.qcloud.la/empty_order.png" mode="aspectFit"></image>
      <text class="empty-text">您还没有任何订单哦，快去点餐吧！</text>
      <button class="action-button" bindtap="goToOrder">前往点单</button>
    </view>
  </block>

  <block wx:elif="{{isLoggedIn && hasOrders && !loading}}">
    <scroll-view scroll-y class="orders-scroll-view">
    <view class="order-list">
        <view class="order-card" wx:for="{{ordersList}}" wx:for-item="order" wx:key="_id">
          <view class="order-header">
            <text class="order-user-info">
              {{userName}}
            </text>
            <text class="order-bed-number" wx:if="{{bedNumber}}">
              床号：{{bedNumber}}
            </text>
            <text class="order-bed-number" wx:else>
              床号：无
            </text>
          </view>

          <view class="order-items-display">
            <view class="item-images-wrapper">
              <view class="item-image-box"
                    wx:for="{{order.displayedItems}}"
                    wx:for-item="productItem"
                    wx:key="name">
                <image class="item-image" src="{{productItem.imageUrl}}" mode="aspectFill" binderror="onImageError" data-item-id="{{productItem.name}}"></image>
                <text class="item-count-overlay">x{{productItem.count}}</text>
              </view>
              <view class="more-items-placeholder" wx:if="{{order.showMorePlaceholder}}">
                <text>等{{order.items.length}}件</text>
              </view>
            </view>

            <view class="order-footer">
              <text class="order-time">{{order.formattedCreateTime}}</text>
            </view>
            <view class="order-footer-id" bindtap="goToBroadcast" data-order="{{order}}">
              <text class="order-ID">订单号：{{order._id}}  </text>
              <image class="arrow-icon" src="/images/component/arrow.svg" mode="aspectFit" />
            </view>
          </view>

        </view>
      </view>
    </scroll-view>
  </block>
</view>