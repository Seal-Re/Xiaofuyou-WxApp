/* pages/myQrCode/myQrCode.wxss */
.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    background-color: #f0f0f0;
  }
  
  .qr-code-container {
    background-color: #fff;
    padding: 20rpx;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  }
  
  .qr-code-container image {
    width: 500rpx; /* 调整二维码图片的大小 */
    height: auto;
  }